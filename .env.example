# Variables d'environnement du backend (à définir dans Vercel → Settings → Environment Variables).
# Ne mets JAMAIS les vraies valeurs dans ce fichier : il est commité.

# Backend FastAPI (Render) qui applique le fond via Gemini
RENDER_API_URL=https://gemini-api-ko4v.onrender.com

# Supabase (même projet que le front)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
# Clé service_role (SERVEUR uniquement) — crédite/débite les comptes
SUPABASE_SERVICE_ROLE_KEY=xxx

# Stripe
STRIPE_SECRET_KEY=sk_...
STRIPE_WEBHOOK_SECRET=whsec_...
